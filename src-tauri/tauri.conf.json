{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalcPad",
  "version": "3.0.0",
  "identifier": "filipesabella.CalcPad",
  "build": {
    "beforeDevCommand": "yarn start-server",
    "devUrl": "http://localhost:1234",
    "beforeBuildCommand": "yarn build-desktop",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss:",
        "media-src": "'self'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNzg0NDQwN0U5ODg0QkIKUldTN2hKaCtRRVI0ZmttVXdzL0tsWTVJWmFvVjRVcXBDMHp1N2dXcTNsVWhHbGZWYUdXeTNjSVoK",
      "endpoints": [
        "https://github.com/filipesabella/calcpad/releases/latest/download/latest.json"
      ]
    }
  }
}
