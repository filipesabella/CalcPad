{
  "name": "CalcPad",
  "description": "A diffent take on the calculator",
  "author": "Filipe Sabella <no-reply@filipesabella.github.io>",
  "repository": "https://github.com/filipesabella/CalcPad",
  "version": "2.0.1",
  "main": "src/electron/main.js",
  "email": "no-reply@filipesabella.github.io",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start-web": "vite --mode web",
    "start-server": "vite --mode desktop",
    "start-electron": "cross-env NODE_ENV=dev ELECTRON_START_URL=http://localhost:1234/index-desktop.html electron .",
    "test": "cross-env NODE_ENV=dev mocha --import=tsx \"src/test/**.spec.ts\"",
    "test:watch": "cross-env NODE_ENV=dev mocha --import=tsx --watch --watch-files src \"src/**/**.spec.ts\"",
    "build-web": "vite build --mode web",
    "build-desktop": "vite build --mode desktop",
    "ship-windows": "rd /s /q dist && rd /s /q build && yarn build-desktop && electron-builder -w",
    "ship-linux": "rm -rf dist build && yarn build-desktop && electron-builder --linux deb rpm AppImage snap",
    "ship-mac": "rm -rf dist build && yarn build-desktop && electron-builder --mac dmg",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "filipesabella.CalcPad",
    "mac": {
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "filipesabella",
        "repo": "CalcPad"
      }
    ],
    "files": [
      "src/electron/*",
      "build/*"
    ]
  },
  "license": "ISC",
  "devDependencies": {
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
    "@types/convert-units": "^2.3.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-reload": "2.0.0-alpha.1",
    "less": "^4.9.1",
    "mocha": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "convert-units": "^2.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
