{
  "name": "CalcPad",
  "description": "A diffent take on the calculator",
  "author": "Filipe Sabella <no-reply@filipesabella.github.io>",
  "repository": "https://github.com/filipesabella/CalcPad",
  "version": "2.0.1",
  "email": "no-reply@filipesabella.github.io",
  "scripts": {
    "start-web": "vite --mode web",
    "start-server": "vite --mode desktop",
    "start-desktop": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-web": "vite build --mode web",
    "build-desktop": "vite build --mode desktop",
    "tauri": "tauri",
    "ship-windows": "tauri build --bundles msi nsis",
    "ship-linux": "tauri build --bundles deb rpm appimage",
    "ship-mac": "tauri build --bundles dmg",
    "typecheck": "tsc --noEmit",
    "format": "dprint fmt"
  },
  "license": "ISC",
  "devDependencies": {
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
